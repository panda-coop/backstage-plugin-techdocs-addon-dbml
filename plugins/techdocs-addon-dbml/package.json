{
  "name": "backstage-plugin-techdocs-addon-dbml",
  "version": "0.1.0",
  "description": "Backstage TechDocs addon rendering interactive DBML diagrams",
  "license": "GPL-3.0-or-later",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "techdocs",
    "pluginPackage": "@backstage/plugin-techdocs"
  },
  "keywords": [
    "backstage",
    "techdocs",
    "techdocs-addon",
    "dbml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panda-coop/backstage-plugin-techdocs-addon-dbml.git",
    "directory": "plugins/techdocs-addon-dbml"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
